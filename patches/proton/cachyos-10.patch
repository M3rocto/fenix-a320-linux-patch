--- /dev/null
+++ b/dlls/d2d1/display-effects.c.inc
@@ -0,0 +1,222 @@
+/* Opt-in support for Fenix's Blend(Overlay, bitmap, Scale(bitmap)) graph.
+ * The vendor application is unchanged. Unsupported graphs retain Wine's
+ * existing behavior. Scaling and premultiplied-alpha blending run on the GPU.
+ */
+#include "d2d1effects.h"
+
+static INIT_ONCE display_effect_once = INIT_ONCE_STATIC_INIT;
+static BOOL display_effect_enabled;
+
+static BOOL CALLBACK d2d_display_effect_init_scope(INIT_ONCE *once, void *parameter, void **result)
+{
+    WCHAR scope[512], path[MAX_PATH], *base, *name, *end;
+    DWORD length = GetEnvironmentVariableW(L"WINE_D2D1_DISPLAY_EFFECTS", scope, ARRAY_SIZE(scope));
+
+    if (!length || length >= ARRAY_SIZE(scope)) return TRUE;
+    if (!wcscmp(scope, L"1")) { display_effect_enabled = TRUE; return TRUE; }
+    if (!GetModuleFileNameW(NULL, path, ARRAY_SIZE(path))) return TRUE;
+    base = wcsrchr(path, L'\\'); base = base ? base + 1 : path;
+    for (name = scope; name && *name; name = end)
+    {
+        if ((end = wcschr(name, L';'))) *end++ = 0;
+        if (!wcsicmp(name, base)) { display_effect_enabled = TRUE; break; }
+    }
+    return TRUE;
+}
+
+BOOL d2d_display_effect_enabled(void)
+{
+    InitOnceExecuteOnce(&display_effect_once, d2d_display_effect_init_scope, NULL, NULL);
+    return display_effect_enabled;
+}
+
+static void d2d_display_effect_cleanup(struct d2d_device_context *context)
+{
+    if (context->display_effect_vs) ID3D11VertexShader_Release(context->display_effect_vs);
+    if (context->display_effect_ps) ID3D11PixelShader_Release(context->display_effect_ps);
+    if (context->display_effect_cb) ID3D11Buffer_Release(context->display_effect_cb);
+    if (context->display_effect_rs) ID3D11RasterizerState_Release(context->display_effect_rs);
+    if (context->display_effect_sampler) ID3D11SamplerState_Release(context->display_effect_sampler);
+    context->display_effect_vs = NULL;
+    context->display_effect_ps = NULL;
+    context->display_effect_cb = NULL;
+    context->display_effect_rs = NULL;
+    context->display_effect_sampler = NULL;
+}
+
+static HRESULT d2d_display_effect_init_gpu(struct d2d_device_context *context)
+{
+    static const char vs[] =
+        "float4 main(uint id : SV_VertexID) : SV_Position {"
+        " float2 p = float2((id << 1) & 2, id & 2);"
+        " return float4(p * float2(2,-2) + float2(-1,1),0,1); }";
+    static const char ps[] =
+        "Texture2D background : register(t0); Texture2D foreground : register(t1);"
+        "SamplerState image_sampler : register(s0);"
+        "cbuffer Params : register(b0) { float4 sizes; float4 alpha_flags; };"
+        "float4 main(float4 p : SV_Position) : SV_Target {"
+        " float2 ub = p.xy / sizes.xy, uf = p.xy / sizes.zw;"
+        " float4 b = background.Sample(image_sampler,ub);"
+        " float4 f = foreground.Sample(image_sampler,uf);"
+        " if(alpha_flags.x > 0.5) b.a=1; if(alpha_flags.y > 0.5) f.a=1;"
+        " if(any(ub<0)||any(ub>1)) b=0; if(any(uf<0)||any(uf>1)) f=0;"
+        " float3 bc=b.a>0 ? b.rgb/b.a : 0; float3 fc=f.a>0 ? f.rgb/f.a : 0;"
+        " float3 low=2*bc*fc, high=1-2*(1-bc)*(1-fc);"
+        " float3 blended=float3(bc.r<=0.5?low.r:high.r,bc.g<=0.5?low.g:high.g,bc.b<=0.5?low.b:high.b);"
+        " return saturate(float4(blended*b.a*f.a + f.rgb*(1-b.a) + b.rgb*(1-f.a),f.a+b.a-f.a*b.a)); }";
+    ID3D10Blob *compiled = NULL, *errors = NULL;
+    D3D11_BUFFER_DESC buffer = {0};
+    D3D11_RASTERIZER_DESC rasterizer = {0};
+    D3D11_SAMPLER_DESC sampler = {0};
+    HRESULT hr;
+
+    if (context->display_effect_ps) return S_OK;
+    if (FAILED(hr = D3DCompile(vs, sizeof(vs)-1, "display effect vs", NULL, NULL,
+            "main", "vs_4_0", 0, 0, &compiled, &errors))) goto failed;
+    hr = ID3D11Device1_CreateVertexShader(context->d3d_device, ID3D10Blob_GetBufferPointer(compiled),
+            ID3D10Blob_GetBufferSize(compiled), NULL, &context->display_effect_vs);
+    ID3D10Blob_Release(compiled); compiled = NULL;
+    if (errors) { ID3D10Blob_Release(errors); errors = NULL; }
+    if (FAILED(hr)) goto failed;
+    if (FAILED(hr = D3DCompile(ps, sizeof(ps)-1, "display effect ps", NULL, NULL,
+            "main", "ps_4_0", 0, 0, &compiled, &errors))) goto failed;
+    hr = ID3D11Device1_CreatePixelShader(context->d3d_device, ID3D10Blob_GetBufferPointer(compiled),
+            ID3D10Blob_GetBufferSize(compiled), NULL, &context->display_effect_ps);
+    ID3D10Blob_Release(compiled); compiled = NULL;
+    if (FAILED(hr)) goto failed;
+    if (errors) { ID3D10Blob_Release(errors); errors = NULL; }
+    buffer.ByteWidth = 32; buffer.Usage = D3D11_USAGE_DEFAULT; buffer.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    if (FAILED(hr = ID3D11Device1_CreateBuffer(context->d3d_device, &buffer, NULL, &context->display_effect_cb))) goto failed;
+    rasterizer.FillMode = D3D11_FILL_SOLID; rasterizer.CullMode = D3D11_CULL_NONE; rasterizer.DepthClipEnable = TRUE;
+    if (FAILED(hr = ID3D11Device1_CreateRasterizerState(context->d3d_device, &rasterizer, &context->display_effect_rs))) goto failed;
+    sampler.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+    sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    sampler.MaxLOD = D3D11_FLOAT32_MAX;
+    if (FAILED(hr = ID3D11Device1_CreateSamplerState(context->d3d_device, &sampler, &context->display_effect_sampler))) goto failed;
+    return S_OK;
+failed:
+    WARN("Display effect shader setup failed, hr %#lx%s%s.\n", hr, errors ? ": " : "",
+            errors ? (char *)ID3D10Blob_GetBufferPointer(errors) : "");
+    if (errors) ID3D10Blob_Release(errors);
+    if (compiled) ID3D10Blob_Release(compiled);
+    d2d_display_effect_cleanup(context);
+    return hr;
+}
+
+struct display_effect_input
+{
+    ID2D1Bitmap *iface;
+    struct d2d_bitmap *bitmap;
+    float width, height;
+};
+
+static HRESULT d2d_display_effect_input(ID2D1Image *image, struct display_effect_input *out, unsigned int depth)
+{
+    ID2D1Effect *effect = NULL;
+    ID2D1Image *input = NULL;
+    D2D1_VECTOR_2F scale, center;
+    UINT32 interpolation, border;
+    CLSID clsid;
+    HRESULT hr;
+
+    if (!image || depth > 4) return E_NOTIMPL;
+    if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1Bitmap, (void **)&out->iface)))
+    {
+        out->bitmap = unsafe_impl_from_ID2D1Bitmap(out->iface);
+        if (!out->bitmap->srv || out->bitmap->dpi_x != 96.0f || out->bitmap->dpi_y != 96.0f)
+        { ID2D1Bitmap_Release(out->iface); out->iface = NULL; return E_NOTIMPL; }
+        out->width = out->bitmap->pixel_size.width; out->height = out->bitmap->pixel_size.height;
+        return S_OK;
+    }
+    if (FAILED(ID2D1Image_QueryInterface(image, &IID_ID2D1Effect, (void **)&effect))) return E_NOTIMPL;
+    hr = E_NOTIMPL;
+    if (FAILED(ID2D1Effect_GetValue(effect, D2D1_PROPERTY_CLSID, D2D1_PROPERTY_TYPE_CLSID, (BYTE *)&clsid, sizeof(clsid)))
+            || !IsEqualGUID(&clsid, &CLSID_D2D1Scale)) goto done;
+    if (FAILED(ID2D1Effect_GetValue(effect, D2D1_SCALE_PROP_SCALE, D2D1_PROPERTY_TYPE_VECTOR2, (BYTE *)&scale, sizeof(scale)))
+            || FAILED(ID2D1Effect_GetValue(effect, D2D1_SCALE_PROP_CENTER_POINT, D2D1_PROPERTY_TYPE_VECTOR2, (BYTE *)&center, sizeof(center)))
+            || FAILED(ID2D1Effect_GetValue(effect, D2D1_SCALE_PROP_INTERPOLATION_MODE, D2D1_PROPERTY_TYPE_ENUM, (BYTE *)&interpolation, sizeof(interpolation)))
+            || FAILED(ID2D1Effect_GetValue(effect, D2D1_SCALE_PROP_BORDER_MODE, D2D1_PROPERTY_TYPE_ENUM, (BYTE *)&border, sizeof(border)))) goto done;
+    if (center.x || center.y || scale.x <= 0 || scale.y <= 0
+            || interpolation != D2D1_SCALE_INTERPOLATION_MODE_LINEAR || border != D2D1_BORDER_MODE_SOFT) goto done;
+    ID2D1Effect_GetInput(effect, 0, &input);
+    if (SUCCEEDED(hr = d2d_display_effect_input(input, out, depth + 1)))
+    { out->width *= scale.x; out->height *= scale.y; }
+done:
+    if (input) ID2D1Image_Release(input);
+    ID2D1Effect_Release(effect);
+    return hr;
+}
+
+static HRESULT d2d_display_effect_render(struct d2d_device_context *context, ID2D1Image *image, struct d2d_bitmap **result)
+{
+    struct display_effect_input inputs[2] = {{0}};
+    ID2D1Effect *effect = NULL;
+    ID2D1Image *input = NULL;
+    ID3D11DeviceContext1 *gpu;
+    ID3DDeviceContextState *previous;
+    ID3D11ShaderResourceView *views[2];
+    D2D1_BITMAP_PROPERTIES1 properties = {0};
+    D2D1_SIZE_U size;
+    D3D11_VIEWPORT viewport = {0};
+    float constants[8] = {0};
+    UINT32 mode;
+    CLSID clsid;
+    HRESULT hr = E_NOTIMPL;
+    unsigned int i;
+
+    *result = NULL;
+    if (FAILED(ID2D1Image_QueryInterface(image, &IID_ID2D1Effect, (void **)&effect))) return E_NOTIMPL;
+    if (FAILED(ID2D1Effect_GetValue(effect, D2D1_PROPERTY_CLSID, D2D1_PROPERTY_TYPE_CLSID, (BYTE *)&clsid, sizeof(clsid)))
+            || !IsEqualGUID(&clsid, &CLSID_D2D1Blend)
+            || FAILED(ID2D1Effect_GetValue(effect, D2D1_BLEND_PROP_MODE, D2D1_PROPERTY_TYPE_ENUM, (BYTE *)&mode, sizeof(mode)))
+            || mode != D2D1_BLEND_MODE_OVERLAY) goto done;
+    for (i = 0; i < 2; ++i)
+    {
+        ID2D1Effect_GetInput(effect, i, &input);
+        hr = d2d_display_effect_input(input, &inputs[i], 0);
+        if (input) ID2D1Image_Release(input);
+        if (FAILED(hr)) goto done;
+        constants[2*i] = inputs[i].width; constants[2*i+1] = inputs[i].height;
+        constants[4+i] = inputs[i].bitmap->format.alphaMode == D2D1_ALPHA_MODE_IGNORE;
+        views[i] = inputs[i].bitmap->srv;
+    }
+    hr = E_NOTIMPL;
+    if (!(constants[0] > 0 && constants[1] > 0 && constants[2] > 0 && constants[3] > 0)
+            || !isfinite(constants[0]) || !isfinite(constants[1]) || !isfinite(constants[2]) || !isfinite(constants[3])) goto done;
