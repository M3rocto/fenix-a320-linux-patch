+/* Optional geometry-only interoperability with a separately installed native
+ * Direct2D implementation. Rendering and all public objects stay in Wine.
+ * WINE_D2D1_GEOMETRY_PROVIDER accepts one executable basename or 1 for tests. */
+static INIT_ONCE geometry_provider_once = INIT_ONCE_STATIC_INIT;
+static ID2D1Factory *geometry_provider_factory;
+
+static BOOL CALLBACK d2d_geometry_provider_init(INIT_ONCE *once, void *parameter, void **context)
+{
+    HRESULT (WINAPI *create_factory)(D2D1_FACTORY_TYPE, REFIID, const D2D1_FACTORY_OPTIONS *, void **);
+    WCHAR enabled[MAX_PATH], executable[MAX_PATH], *basename;
+    DWORD length;
+    HMODULE module;
+    HRESULT hr;
+
+    length = GetEnvironmentVariableW(L"WINE_D2D1_GEOMETRY_PROVIDER", enabled, ARRAY_SIZE(enabled));
+    if (!length || length >= ARRAY_SIZE(enabled)) return TRUE;
+    if (lstrcmpW(enabled, L"1"))
+    {
+        length = GetModuleFileNameW(NULL, executable, ARRAY_SIZE(executable));
+        if (!length || length >= ARRAY_SIZE(executable)) return TRUE;
+        basename = wcsrchr(executable, '\\');
+        if (lstrcmpiW(enabled, basename ? basename + 1 : executable)) return TRUE;
+    }
+
+    if (!(module = LoadLibraryExW(L"d2d1_geometry.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32)))
+        return TRUE;
+    if (!(create_factory = (void *)GetProcAddress(module, "D2D1CreateFactory")))
+    {
+        FreeLibrary(module);
+        return TRUE;
+    }
+    hr = create_factory(D2D1_FACTORY_TYPE_MULTI_THREADED, &IID_ID2D1Factory, NULL,
+            (void **)&geometry_provider_factory);
+    if (FAILED(hr))
+    {
+        geometry_provider_factory = NULL;
+        FreeLibrary(module);
+    }
+    /* The shared factory and its module live for this process's lifetime. */
+    return TRUE;
+}
+
+static HRESULT d2d_geometry_provider_copy(ID2D1Geometry *source, ID2D1Geometry **result)
+{
+    ID2D1RectangleGeometry *rectangle;
+    ID2D1RoundedRectangleGeometry *rounded;
+    ID2D1EllipseGeometry *ellipse;
+    ID2D1TransformedGeometry *transformed;
+    ID2D1GeometryGroup *group;
+    ID2D1PathGeometry *path;
+    ID2D1GeometrySink *sink;
+    HRESULT hr, close_hr;
+
+    *result = NULL;
+    if (SUCCEEDED(ID2D1Geometry_QueryInterface(source, &IID_ID2D1RectangleGeometry, (void **)&rectangle)))
+    {
+        D2D1_RECT_F rect;
+        ID2D1RectangleGeometry_GetRect(rectangle, &rect);
+        ID2D1RectangleGeometry_Release(rectangle);
+        return ID2D1Factory_CreateRectangleGeometry(geometry_provider_factory, &rect,
+                (ID2D1RectangleGeometry **)result);
+    }
+    if (SUCCEEDED(ID2D1Geometry_QueryInterface(source, &IID_ID2D1RoundedRectangleGeometry, (void **)&rounded)))
+    {
+        D2D1_ROUNDED_RECT rect;
+        ID2D1RoundedRectangleGeometry_GetRoundedRect(rounded, &rect);
+        ID2D1RoundedRectangleGeometry_Release(rounded);
+        return ID2D1Factory_CreateRoundedRectangleGeometry(geometry_provider_factory, &rect,
+                (ID2D1RoundedRectangleGeometry **)result);
+    }
+    if (SUCCEEDED(ID2D1Geometry_QueryInterface(source, &IID_ID2D1EllipseGeometry, (void **)&ellipse)))
+    {
+        D2D1_ELLIPSE shape;
+        ID2D1EllipseGeometry_GetEllipse(ellipse, &shape);
+        ID2D1EllipseGeometry_Release(ellipse);
+        return ID2D1Factory_CreateEllipseGeometry(geometry_provider_factory, &shape,
+                (ID2D1EllipseGeometry **)result);
+    }
+    if (SUCCEEDED(ID2D1Geometry_QueryInterface(source, &IID_ID2D1TransformedGeometry, (void **)&transformed)))
+    {
+        ID2D1Geometry *original, *copy;
+        D2D1_MATRIX_3X2_F transform;
+        ID2D1TransformedGeometry_GetSourceGeometry(transformed, &original);
+        ID2D1TransformedGeometry_GetTransform(transformed, &transform);
+        ID2D1TransformedGeometry_Release(transformed);
+        hr = d2d_geometry_provider_copy(original, &copy);
+        ID2D1Geometry_Release(original);
+        if (FAILED(hr)) return hr;
+        hr = ID2D1Factory_CreateTransformedGeometry(geometry_provider_factory, copy, &transform,
+                (ID2D1TransformedGeometry **)result);
+        ID2D1Geometry_Release(copy);
+        return hr;
+    }
+    if (SUCCEEDED(ID2D1Geometry_QueryInterface(source, &IID_ID2D1GeometryGroup, (void **)&group)))
+    {
+        UINT32 i, count = ID2D1GeometryGroup_GetSourceGeometryCount(group);
+        ID2D1Geometry **originals = calloc(count ? count : 1, sizeof(*originals));
+        ID2D1Geometry **copies = calloc(count ? count : 1, sizeof(*copies));
+        if (!originals || !copies)
+            hr = E_OUTOFMEMORY;
+        else
+        {
+            ID2D1GeometryGroup_GetSourceGeometries(group, originals, count);
+            hr = S_OK;
+            for (i = 0; i < count && SUCCEEDED(hr); ++i)
+                hr = d2d_geometry_provider_copy(originals[i], &copies[i]);
+            if (SUCCEEDED(hr))
+                hr = ID2D1Factory_CreateGeometryGroup(geometry_provider_factory,
+                        ID2D1GeometryGroup_GetFillMode(group), copies, count, (ID2D1GeometryGroup **)result);
+            for (i = 0; i < count; ++i)
+            {
+                ID2D1Geometry_Release(originals[i]);
+                if (copies[i]) ID2D1Geometry_Release(copies[i]);
+            }
+        }
+        free(originals);
+        free(copies);
+        ID2D1GeometryGroup_Release(group);
+        return hr;
+    }
+    if (FAILED(hr = ID2D1Factory_CreatePathGeometry(geometry_provider_factory, &path)))
+        return hr;
+    if (SUCCEEDED(hr = ID2D1PathGeometry_Open(path, &sink)))
+    {
+        ID2D1PathGeometry *original;
+        /* Preserve exact arc segments; CachyOS implements Stream but its
+         * Simplify path changes rotated elliptical arcs. */
+        if (SUCCEEDED(ID2D1Geometry_QueryInterface(source, &IID_ID2D1PathGeometry, (void **)&original)))
+        {
+            hr = ID2D1PathGeometry_Stream(original, sink);
+            ID2D1PathGeometry_Release(original);
+        }
+        else
+            hr = ID2D1Geometry_Simplify(source, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_CUBICS_AND_LINES,
+                    NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE, (ID2D1SimplifiedGeometrySink *)sink);
+        close_hr = ID2D1GeometrySink_Close(sink);
+        ID2D1GeometrySink_Release(sink);
+        if (SUCCEEDED(hr)) hr = close_hr;
+    }
+    if (FAILED(hr)) ID2D1PathGeometry_Release(path);
+    else *result = (ID2D1Geometry *)path;
+    return hr;
+}
+
+static HRESULT d2d_geometry_provider_combine(ID2D1Geometry *source, ID2D1Geometry *input,
+        D2D1_COMBINE_MODE mode, const D2D1_MATRIX_3X2_F *transform, float tolerance,
+        ID2D1SimplifiedGeometrySink *sink)
+{
+    ID2D1Geometry *source_copy, *input_copy;
+    HRESULT hr;
+
+    if (!input || !sink) return E_INVALIDARG;
+    InitOnceExecuteOnce(&geometry_provider_once, d2d_geometry_provider_init, NULL, NULL);
+    if (!geometry_provider_factory) return E_NOTIMPL;
+    if (FAILED(hr = d2d_geometry_provider_copy(source, &source_copy))) return hr;
+    if (SUCCEEDED(hr = d2d_geometry_provider_copy(input, &input_copy)))
+    {
+        hr = ID2D1Geometry_CombineWithGeometry(source_copy, input_copy, mode, transform, tolerance, sink);
+        ID2D1Geometry_Release(input_copy);
+    }
+    ID2D1Geometry_Release(source_copy);
+    return hr;
+}
+
+/* Preserve native distance, endpoint and tangent semantics, including curved
+ * and transformed paths. The same opt-in process scope as CombineWithGeometry
+ * applies; applications without the provider retain the original E_NOTIMPL. */
+static HRESULT d2d_geometry_provider_compute_length(ID2D1Geometry *source,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, float *length)
+{
+    ID2D1Geometry *copy;
+    HRESULT hr;
+
+    InitOnceExecuteOnce(&geometry_provider_once, d2d_geometry_provider_init, NULL, NULL);
+    if (!geometry_provider_factory) return E_NOTIMPL;
+    if (FAILED(hr = d2d_geometry_provider_copy(source, &copy))) return hr;
+    hr = ID2D1Geometry_ComputeLength(copy, transform, tolerance, length);
+    ID2D1Geometry_Release(copy);
+    return hr;
+}
+
+static HRESULT d2d_geometry_provider_compute_point(ID2D1Geometry *source, float length,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, D2D1_POINT_2F *point, D2D1_POINT_2F *tangent)
+{
+    ID2D1Geometry *copy;
+    HRESULT hr;
+
+    InitOnceExecuteOnce(&geometry_provider_once, d2d_geometry_provider_init, NULL, NULL);
+    if (!geometry_provider_factory) return E_NOTIMPL;
+    if (FAILED(hr = d2d_geometry_provider_copy(source, &copy))) return hr;
+    hr = ID2D1Geometry_ComputePointAtLength(copy, length, transform, tolerance, point, tangent);
+    ID2D1Geometry_Release(copy);
+    return hr;
+}
+
+/* Wine's outline shader does not implement stroke joins, caps or dashes. Use
+ * the opt-in geometry provider to construct their actual filled contour,
+ * preserving the caller's style (including native zero-miter-limit handling).
+ * Only geometry computation crosses the provider boundary; rendering and the
+ * returned path remain in this Wine factory. */
+HRESULT d2d_geometry_provider_stroke_outline(ID2D1Geometry *source, float width,
+        ID2D1StrokeStyle *style, float tolerance, ID2D1PathGeometry **result)
+{
+    D2D1_STROKE_STYLE_PROPERTIES properties;
+    ID2D1StrokeStyle *native_style = NULL;
+    ID2D1Geometry *copy = NULL;
+    ID2D1Factory *factory = NULL;
+    ID2D1PathGeometry *path = NULL;
+    ID2D1GeometrySink *sink = NULL;
+    float *dashes = NULL;
+    UINT32 count = 0;
+    HRESULT hr, close_hr;
+
+    *result = NULL;
+    InitOnceExecuteOnce(&geometry_provider_once, d2d_geometry_provider_init, NULL, NULL);
+    if (!geometry_provider_factory) return E_NOTIMPL;
+    if (FAILED(hr = d2d_geometry_provider_copy(source, &copy))) return hr;
+
+    if (style)
+    {
+        properties.startCap = ID2D1StrokeStyle_GetStartCap(style);
+        properties.endCap = ID2D1StrokeStyle_GetEndCap(style);
+        properties.dashCap = ID2D1StrokeStyle_GetDashCap(style);
+        properties.lineJoin = ID2D1StrokeStyle_GetLineJoin(style);
+        properties.miterLimit = ID2D1StrokeStyle_GetMiterLimit(style);
+        properties.dashStyle = ID2D1StrokeStyle_GetDashStyle(style);
+        properties.dashOffset = ID2D1StrokeStyle_GetDashOffset(style);
+        if (properties.dashStyle == D2D1_DASH_STYLE_CUSTOM && (count = ID2D1StrokeStyle_GetDashesCount(style)))
+        {
+            if (!(dashes = calloc(count, sizeof(*dashes))))
+            { hr = E_OUTOFMEMORY; goto done; }
+            ID2D1StrokeStyle_GetDashes(style, dashes, count);
+        }
+        if (FAILED(hr = ID2D1Factory_CreateStrokeStyle(geometry_provider_factory,
+                &properties, dashes, count, &native_style))) goto done;
+    }
+    ID2D1Geometry_GetFactory(source, &factory);
+    if (FAILED(hr = ID2D1Factory_CreatePathGeometry(factory, &path))) goto done;
+    if (FAILED(hr = ID2D1PathGeometry_Open(path, &sink))) goto done;
+    hr = ID2D1Geometry_Widen(copy, width, native_style, NULL, tolerance,
+            (ID2D1SimplifiedGeometrySink *)sink);
+    close_hr = ID2D1GeometrySink_Close(sink);
+    if (SUCCEEDED(hr)) hr = close_hr;
+    if (SUCCEEDED(hr)) { *result = path; path = NULL; }
+done:
+    if (sink) ID2D1GeometrySink_Release(sink);
