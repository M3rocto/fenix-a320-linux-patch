+struct session_notification
+{
+    struct list entry;
+    IAudioSessionNotification *callback;
+    LONG ref;
+    BOOL registered;
+};
+
+static struct list session_managers = LIST_INIT(session_managers);
+
+static void release_notification(struct session_notification *notification)
+{
+    if (!InterlockedDecrement(&notification->ref))
+    {
+        IAudioSessionNotification_Release(notification->callback);
+        free(notification);
+    }
+}
+
+struct session_notification_work
+{
+    struct session_mgr *manager;
+    struct session_notification *notification;
+    IAudioSessionControl *control;
+};
+
+static DWORD WINAPI deliver_session_notification(void *arg)
+{
+    struct session_notification_work *work = arg;
+    HRESULT hr = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    BOOL registered;
+
+    sessions_lock();
+    registered = work->notification->registered;
+    sessions_unlock();
+    if (SUCCEEDED(hr) && registered)
+        IAudioSessionNotification_OnSessionCreated(work->notification->callback, work->control);
+    IAudioSessionControl_Release(work->control);
+    release_notification(work->notification);
+    IAudioSessionManager2_Release(&work->manager->IAudioSessionManager2_iface);
+    free(work);
+    if (SUCCEEDED(hr)) CoUninitialize();
+    return 0;
+}
+
+void notify_audio_session_created(struct audio_session *session)
+{
+    struct session_mgr *manager;
+    struct session_notification *notification;
+
+    sessions_lock();
+    LIST_FOR_EACH_ENTRY(manager, &session_managers, struct session_mgr, entry)
+    {
+        if (manager->device != session->device || !manager->notifications_enabled) continue;
+        LIST_FOR_EACH_ENTRY(notification, &manager->notifications, struct session_notification, entry)
+        {
+            struct session_notification_work *work;
+            struct audio_session_wrapper *wrapper;
+            if (!(work = malloc(sizeof(*work)))) continue;
+            if (!(wrapper = session_wrapper_create(NULL)))
+            {
+                free(work);
+                continue;
+            }
+            wrapper->session = session;
+            work->manager = manager;
+            work->notification = notification;
+            work->control = (IAudioSessionControl *)&wrapper->IAudioSessionControl2_iface;
+            IAudioSessionManager2_AddRef(&manager->IAudioSessionManager2_iface);
+            InterlockedIncrement(&notification->ref);
+            if (!QueueUserWorkItem(deliver_session_notification, work, WT_EXECUTEDEFAULT))
+            {
+                IAudioSessionControl_Release(work->control);
+                release_notification(notification);
+                IAudioSessionManager2_Release(&manager->IAudioSessionManager2_iface);
+                free(work);
+            }
+        }
+    }
+    sessions_unlock();
+}
