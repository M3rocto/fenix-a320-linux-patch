+static BOOL CALLBACK init_outline_scope(INIT_ONCE *once, void *parameter, void **result)
+{
+    WCHAR scope[512], path[MAX_PATH], *base, *name, *end;
+    DWORD length = GetEnvironmentVariableW(L"WINE_DWRITE_UNHINTED_OUTLINES", scope, ARRAY_SIZE(scope));
+
+    if (!length || length >= ARRAY_SIZE(scope)) return TRUE;
+    if (!wcscmp(scope, L"1")) { unhinted_outlines = TRUE; return TRUE; }
+    if (!GetModuleFileNameW(NULL, path, ARRAY_SIZE(path))) return TRUE;
+    base = wcsrchr(path, L'\\'); base = base ? base + 1 : path;
+    for (name = scope; name && *name; name = end)
+    {
+        if ((end = wcschr(name, L';'))) *end++ = 0;
+        if (!wcsicmp(name, base)) { unhinted_outlines = TRUE; break; }
+    }
+    return TRUE;
+}
