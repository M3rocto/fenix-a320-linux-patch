+NTSTATUS WINAPI NtGdiDdDDIGetSharedResourceAdapterLuid( D3DKMT_GETSHAREDRESOURCEADAPTERLUID *params )
+{
+    LUID luid = {0};
+    NTSTATUS status;
+
+    if (!params || (!params->hGlobalShare == !params->hNtHandle)) return STATUS_INVALID_PARAMETER;
+    if (params->hGlobalShare && !is_d3dkmt_global( params->hGlobalShare )) return STATUS_INVALID_PARAMETER;
+
+    SERVER_START_REQ( d3dkmt_object_query )
+    {
+        req->type = D3DKMT_RESOURCE;
+        req->global = params->hGlobalShare;
+        req->handle = wine_server_obj_handle( params->hNtHandle );
+        wine_server_set_reply( req, &luid, sizeof(luid) );
+        status = wine_server_call( req );
+        /* Old servers and resources created without owner metadata must not
+         * accidentally identify the first adapter on a multi-GPU system. */
+        if (!status && wine_server_reply_size( reply ) != sizeof(luid)) status = STATUS_NOT_SUPPORTED;
+    }
+    SERVER_END_REQ;
+
+    if (!status) params->AdapterLuid = luid;
+    return status;
+}
