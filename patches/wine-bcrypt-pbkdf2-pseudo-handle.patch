     ok(status == STATUS_SUCCESS, "got %#lx\n", status);
+    if (!pBCryptHash) /* < Win10 */
+    {
+        win_skip("PBKDF2 pseudo handles are not available\n");
+        return;
+    }
+
+    key = NULL;
+    status = BCryptGenerateSymmetricKey(BCRYPT_PBKDF2_ALG_HANDLE, &key, NULL, 0, (UCHAR *)"test", 4, 0);
+    ok(!status, "got %#lx\n", status);
+    if (status) return;
+
+    memset(buf, 'x', sizeof(buf));
+    size = 0;
+    status = pBCryptKeyDerivation(key, &pbkdf2_params, buf, sizeof(buf), &size, 0);
+    ok(!status, "got %#lx\n", status);
+    ok(size == sizeof(buf), "size = %lu\n", size);
+    ok(!memcmp(buf, pbkdf2_hash, sizeof(pbkdf2_hash)), "wrong data\n");
+
+    status = BCryptDestroyKey(key);
+    ok(!status, "got %#lx\n", status);
 }
