@@ -983,6 +983,11 @@
  */
 NTSTATUS WINAPI RtlSetCurrentDirectory_U(const UNICODE_STRING* dir)
 {
+    struct
+    {
+        OBJECT_NAME_INFORMATION info;
+        WCHAR buffer[MAX_PATH + 4];
+    } name;
     FILE_FS_DEVICE_INFORMATION device_info;
     HANDLE handle, old_handle;
     WCHAR cur_path[MAX_PATH];
@@ -1017,6 +1022,25 @@
         return nts;
     }
 
+    ptr = newdir.Buffer;
+    size = newdir.Length / sizeof(WCHAR);
+    if (size >= 15 && !wcsnicmp( ptr, L"\\??\\GLOBALROOT\\", 15 ))
+    {
+        /* A current directory must have a DOS disk or UNC share designator.
+         * Resolve the opened GLOBALROOT alias before dropping the NT prefix. */
+        nts = NtQueryObject( handle, ObjectNameInformation, &name, sizeof(name), NULL );
+        if (nts) goto failed;
+        ptr = name.info.Name.Buffer;
+        size = name.info.Name.Length / sizeof(WCHAR);
+        if (size < 7 || wcsncmp( ptr, L"\\??\\", 4 ) ||
+            ((ptr[5] != ':' || ptr[6] != '\\') &&
+             (size < 8 || wcsnicmp( ptr + 4, L"UNC\\", 4 ))))
+        {
+            nts = STATUS_OBJECT_NAME_INVALID;
+            goto failed;
+        }
+    }
+
     /* don't keep the directory handle open on removable media */
     if (!NtQueryVolumeInformationFile( handle, &io, &device_info,
                                        sizeof(device_info), FileFsDeviceInformation ) &&
@@ -1027,8 +1051,6 @@
     }
 
     /* append trailing \ if missing */
-    size = newdir.Length / sizeof(WCHAR);
-    ptr = newdir.Buffer;
     ptr += 4;  /* skip \??\ prefix */
     size -= 4;
     if (size && ptr[size - 1] != '\\') ptr[size++] = '\\';
@@ -1047,6 +1069,13 @@
     else
         curdir = &NtCurrentTeb()->Peb->ProcessParameters->CurrentDirectory;
 
+    if ((size + 1) * sizeof(WCHAR) > curdir->DosPath.MaximumLength)
+    {
+        RtlReleasePebLock();
+        nts = STATUS_NAME_TOO_LONG;
+        goto failed;
+    }
+
     old_handle = curdir->Handle;
     curdir->Handle = handle;
 
@@ -1060,4 +1089,9 @@
     RtlFreeUnicodeString( &newdir );
     if (old_handle) NtClose( old_handle );
     return nts;
-}
+
+failed:
+    if (handle) NtClose( handle );
+    RtlFreeUnicodeString( &newdir );
+    return nts;
+}
