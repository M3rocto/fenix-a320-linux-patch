diff --git i/src/dxgi/dxgi_factory.cpp w/src/dxgi/dxgi_factory.cpp
index d89409e..e8f509f 100644
--- i/src/dxgi/dxgi_factory.cpp
+++ w/src/dxgi/dxgi_factory.cpp
@@ -418,8 +418,20 @@ namespace dxvk {
   HRESULT STDMETHODCALLTYPE DxgiFactory::GetSharedResourceAdapterLuid(
           HANDLE                hResource,
           LUID*                 pLuid) {
-    Logger::err("DxgiFactory::GetSharedResourceAdapterLuid: Not implemented");
-    return E_NOTIMPL;
+    if (!pLuid)
+      return DXGI_ERROR_INVALID_CALL;
+
+    D3DKMT_GETSHAREDRESOURCEADAPTERLUID query = { };
+    if (reinterpret_cast<uintptr_t>(hResource) & 0xc0000000)
+      query.hGlobalShare = reinterpret_cast<uintptr_t>(hResource);
+    else
+      query.hNtHandle = hResource;
+
+    if (D3DKMTGetSharedResourceAdapterLuid(&query))
+      return DXGI_ERROR_INVALID_CALL;
+
+    *pLuid = query.AdapterLuid;
+    return S_OK;
   }
   
   
diff --git i/src/util/util_gdi.cpp w/src/util/util_gdi.cpp
index 988d9d7..76f93b1 100644
--- i/src/util/util_gdi.cpp
+++ w/src/util/util_gdi.cpp
@@ -4,6 +4,10 @@
 namespace dxvk {
 
 #ifndef _WIN32
+  NTSTATUS WINAPI D3DKMTGetSharedResourceAdapterLuid(D3DKMT_GETSHAREDRESOURCEADAPTERLUID *desc) {
+    return -1;
+  }
+
   NTSTATUS WINAPI D3DKMTAcquireKeyedMutex(D3DKMT_ACQUIREKEYEDMUTEX *desc) {
     Logger::warn("D3DKMTAcquireKeyedMutex: Not available on this platform.");
     return -1;
@@ -109,6 +113,19 @@ namespace dxvk {
     return -1;
   }
 #else
+  static NTSTATUS WINAPI NoD3DKMTGetSharedResourceAdapterLuid(D3DKMT_GETSHAREDRESOURCEADAPTERLUID *desc) {
+    return -1;
+  }
+
+  NTSTATUS WINAPI D3DKMTGetSharedResourceAdapterLuid(D3DKMT_GETSHAREDRESOURCEADAPTERLUID *desc) {
+    static decltype(D3DKMTGetSharedResourceAdapterLuid) *func;
+    if (!func) {
+      InterlockedCompareExchangePointer((void **)&func, (void *)GetProcAddress(GetModuleHandle("gdi32"), "D3DKMTGetSharedResourceAdapterLuid"), NULL);
+      InterlockedCompareExchangePointer((void **)&func, (void *)NoD3DKMTGetSharedResourceAdapterLuid, NULL);
+    }
+    return func(desc);
+  }
+
   static NTSTATUS WINAPI NoD3DKMTAcquireKeyedMutex(D3DKMT_ACQUIREKEYEDMUTEX *desc) {
     return -1;
   }
