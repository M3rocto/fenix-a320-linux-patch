+SECURITY_STATUS WINAPI NCryptSecretAgreement(NCRYPT_KEY_HANDLE private_handle, NCRYPT_KEY_HANDLE public_handle,
+                                            NCRYPT_SECRET_HANDLE *ret_handle, DWORD flags)
+{
+    struct object *private_key = (struct object *)private_handle, *public_key = (struct object *)public_handle;
+    struct object *secret;
+    const struct object_property *usage;
+    NTSTATUS status;
+
+    TRACE("(%#Ix, %#Ix, %p, %#lx)\n", private_handle, public_handle, ret_handle, flags);
+    if (!private_key || !public_key || private_key->type != KEY || public_key->type != KEY) return NTE_INVALID_HANDLE;
+    if (!ret_handle) return NTE_INVALID_PARAMETER;
+    *ret_handle = 0;
+    if (flags & ~NCRYPT_SILENT_FLAG) return NTE_BAD_FLAGS;
+    if (private_key->key.algid != ECDH_P256 || public_key->key.algid != ECDH_P256) return NTE_NOT_SUPPORTED;
+    if (!private_key->key.finalized || !public_key->key.finalized || private_key->key.public_only) return NTE_BAD_KEY_STATE;
+    usage = get_object_property(private_key, NCRYPT_KEY_USAGE_PROPERTY);
+    if (!usage || !(*(DWORD *)usage->value & NCRYPT_ALLOW_KEY_AGREEMENT_FLAG)) return NTE_PERM;
+    if (!(secret = allocate_object(SECRET))) return NTE_NO_MEMORY;
+    status = BCryptSecretAgreement(private_key->key.bcrypt_key, public_key->key.bcrypt_key, &secret->secret, 0);
+    if (status) { free(secret); return map_ntstatus(status); }
+    *ret_handle = (NCRYPT_SECRET_HANDLE)secret;
+    return ERROR_SUCCESS;
+}
+
+SECURITY_STATUS WINAPI NCryptDeriveKey(NCRYPT_SECRET_HANDLE handle, const WCHAR *kdf, NCryptBufferDesc *params,
+                                     BYTE *output, DWORD output_size, DWORD *ret_len, DWORD flags)
+{
+    struct object *secret = (struct object *)handle;
+    NTSTATUS status;
+    ULONG required, i;
+    UCHAR derived[64];
+
+    TRACE("(%#Ix, %s, %p, %p, %lu, %p, %#lx)\n", handle, wine_dbgstr_w(kdf), params, output, output_size, ret_len, flags);
+    if (!secret || secret->type != SECRET) return NTE_INVALID_HANDLE;
+    if (!kdf || !ret_len) return NTE_INVALID_PARAMETER;
+    if (flags & ~(NCRYPT_SILENT_FLAG | KDF_USE_SECRET_AS_HMAC_KEY_FLAG)) return NTE_BAD_FLAGS;
+    if (wcscmp(kdf, BCRYPT_KDF_HASH) && wcscmp(kdf, BCRYPT_KDF_RAW_SECRET)) return NTE_NOT_SUPPORTED;
+    if (params)
+    {
+        if (params->ulVersion != BCRYPTBUFFER_VERSION || (params->cBuffers && !params->pBuffers)) return NTE_INVALID_PARAMETER;
+        if (params->cBuffers > 1) return NTE_NOT_SUPPORTED;
+        for (i = 0; i < params->cBuffers; i++)
+        {
+            NCryptBuffer *buffer = params->pBuffers + i;
+            const WCHAR *hash = buffer->pvBuffer;
+            if (wcscmp(kdf, BCRYPT_KDF_HASH) || buffer->BufferType != KDF_HASH_ALGORITHM) return NTE_NOT_SUPPORTED;
+            if (!hash || buffer->cbBuffer < sizeof(WCHAR) || buffer->cbBuffer % sizeof(WCHAR) ||
+                hash[buffer->cbBuffer / sizeof(WCHAR) - 1]) return NTE_INVALID_PARAMETER;
+            if (wcscmp(hash, BCRYPT_SHA1_ALGORITHM) && wcscmp(hash, BCRYPT_SHA256_ALGORITHM) &&
+                wcscmp(hash, BCRYPT_SHA384_ALGORITHM) && wcscmp(hash, BCRYPT_SHA512_ALGORITHM)) return NTE_NOT_SUPPORTED;
+        }
+    }
+    status = BCryptDeriveKey(secret->secret, kdf, (BCryptBufferDesc *)params, NULL, 0, &required, 0);
+    if (status) return map_ntstatus(status);
+    *ret_len = required;
+    if (!output) return ERROR_SUCCESS;
+    if (required > sizeof(derived)) return NTE_INTERNAL_ERROR;
+    status = BCryptDeriveKey(secret->secret, kdf, (BCryptBufferDesc *)params, derived, sizeof(derived), &required, 0);
+    if (!status)
+    {
+        *ret_len = min(output_size, required);
+        memcpy(output, derived, *ret_len);
+    }
+    SecureZeroMemory(derived, sizeof(derived));
+    return map_ntstatus(status);
 }
 
