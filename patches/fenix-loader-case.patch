--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -1657,6 +1657,22 @@
     }
     if ((p = wcsrchr( buffer, '\\' ))) p++;
     else p = buffer;
+    /* Fenix and its aircraft components enumerate PEB loader entries with
+     * case-sensitive comparisons. Match the Windows spellings for these apps. */
+    if (NtCurrentTeb()->Peb->ProcessParameters)
+    {
+        const WCHAR *image = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer;
+        const WCHAR *exe = image ? wcsrchr( image, '\\' ) : NULL;
+        if (exe && (!wcsicmp( exe + 1, L"Fenix.exe" ) ||
+                    !wcsicmp( exe + 1, L"FenixSystem.exe" ) ||
+                    !wcsicmp( exe + 1, L"FenixDisplay.exe" ) ||
+                    !wcsicmp( exe + 1, L"FenixCDU.exe" ) ||
+                    !wcsicmp( exe + 1, L"Fenix.GqlGateway.exe" )))
+        {
+            if (!wcsicmp( p, L"kernel32.dll" )) memcpy( (WCHAR *)p, L"KERNEL32.DLL", sizeof(L"KERNEL32.DLL") );
+            if (!wcsicmp( p, L"kernelbase.dll" )) memcpy( (WCHAR *)p, L"KERNELBASE.dll", sizeof(L"KERNELBASE.dll") );
+        }
+    }
     RtlInitUnicodeString( &wm->ldr.FullDllName, buffer );
     RtlInitUnicodeString( &wm->ldr.BaseDllName, p );
 
